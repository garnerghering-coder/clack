# Admin token for the server's inside views: /api/health details, /api/import/status, /api/audit, /api/live/status.
# Send it as the header "X-Clack-Admin". Leave empty to turn those routes off (they then answer 404).
# Make one with: openssl rand -hex 32
CLACK_ADMIN_TOKEN=
