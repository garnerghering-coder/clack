TRAFIKVERKET_API_KEY=
TRAFIKLAB_GTFS_SWEDEN3_KEY=
TRAFIKLAB_GTFS_SVERIGE2_KEY=

# Admin token for the server's inside views: /api/health details, /api/import/status, /api/audit, /api/live/status.
# Send it as the header "X-Clack-Admin". Leave empty to turn those routes off (they then answer 404).
# Make one with: openssl rand -hex 32
CLACK_ADMIN_TOKEN=

# Optional. Finland (Digitraffic) needs no key. DIGITRAFFIC_USER goes in the Digitraffic-User header; keep personal
# data out of it. FINLAND_IMPORT=0 turns the daily Finnish timetable import off.
# DIGITRAFFIC_USER=clack
# FINLAND_IMPORT=1

# The observed record (what actually happened to every train; apps/server/src/observed/). On by default.
# OBSERVED=off turns it off; OBSERVED_BACKFILL=off keeps the nightly rounds but not the slow fills of the past.
# OBSERVED_DIR sets where the raw archive goes (default data/observed).
# OBSERVED=on
# OBSERVED_BACKFILL=on

# Optional. Norway's past actual times come from Entur's public BigQuery table, queried from a free BigQuery sandbox
# project with a service account that has the "BigQuery Job User" role. Point this at its JSON key, kept outside the
# repo (never commit it).
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/the/repo/bigquery.json
