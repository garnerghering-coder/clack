    {
      "date": "2026-10-21",
      "who": "Claude (for the owner)",
      "what": "First draft from OSM (2026-10-19 extract) with 7 hand connections for gaps in OSM; see connections[].note."
    },
    {
      "date": "2026-10-22",
      "who": "Claude (for the owner)",
      "what": "Level names checked against Jernhusen's station plan (Centralhallen, Nedre hallen, Övre hallen)."
    },
    {
      "date": "2026-10-22",
      "who": "Claude (for the owner)",
      "what": "Shops, cafés and restaurants from Jernhusen's January 2026 plan, with their outlines: 67 places (25 new), 6 OSM places that the plan no longer lists or that were on the wrong floor removed."
    }
