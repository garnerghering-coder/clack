<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Pulls the server's backups to ~/ClackBackups every hour and at login. Install: docs/SERVER.md "Backups".
     The script is run from ~/Library/Application Support/ClackBackup: macOS keeps background jobs out of ~/Documents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>app.clack.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>-c</string><string>"$HOME/Library/Application Support/ClackBackup/pull.sh"</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/clack-backup.err</string>
</dict>
</plist>
