      }
    },
    "usage.ask.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous daily counts of which screens and features you use, and Apple's crash reports, help us see what to improve. Nothing says who you are. You can change this in Settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyma dagliga antal av vilka vyer och funktioner du använder, och Apples kraschrapporter, hjälper oss se vad som behöver bli bättre. Inget säger vem du är. Du kan ändra det i Inställningar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme daglige optællinger af, hvilke skærme og funktioner du bruger, og Apples nedbrudsrapporter hjælper os med at se, hvad der skal forbedres. Intet siger, hvem du er. Du kan ændre det i Indstillinger."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme daglige tall for hvilke skjermer og funksjoner du bruker, og Apples krasjrapporter, hjelper oss å se hva som bør bli bedre. Ingenting sier hvem du er. Du kan endre dette i Innstillinger."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimettömät päivittäiset laskurit siitä, mitä näyttöjä ja toimintoja käytät, sekä Applen kaatumisraportit auttavat meitä näkemään, mitä parantaa. Mikään ei kerro, kuka olet. Voit muuttaa tätä asetuksissa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme tägliche Zählungen, welche Bildschirme und Funktionen du nutzt, und Apples Absturzberichte helfen uns zu sehen, was wir verbessern können. Nichts sagt, wer du bist. Du kannst das in den Einstellungen ändern."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonimowe dzienne liczniki tego, których ekranów i funkcji używasz, oraz raporty awarii Apple pomagają nam zobaczyć, co poprawić. Nic nie mówi, kim jesteś. Możesz to zmienić w Ustawieniach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des comptages quotidiens anonymes des écrans et fonctions que vous utilisez, et les rapports de plantage d’Apple, nous aident à voir quoi améliorer. Rien ne dit qui vous êtes. Vous pouvez modifier ce choix dans les Réglages."
          }
        }
      }
    },
