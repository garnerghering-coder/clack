    "passport.emptyHow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trips show up here once you’ve taken them: when the train reports at your stops, or when you confirm them."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resor hamnar här när du har åkt dem: när tåget rapporteras vid dina stationer, eller när du bekräftar dem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ture vises her, når du har taget dem: når toget melder ved dine stop, eller når du bekræfter dem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Turer vises her når du har tatt dem: når toget melder fra på stoppene dine, eller når du bekrefter dem."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Matkat näkyvät täällä, kun olet tehnyt ne: kun juna ilmoittaa asemillasi tai kun vahvistat ne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fahrten erscheinen hier, sobald du sie gemacht hast: wenn der Zug an deinen Halten gemeldet wird oder wenn du sie bestätigst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przejazdy pojawiają się tutaj, gdy się odbędą: gdy pociąg zgłosi się na twoich przystankach albo gdy je potwierdzisz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les trajets s’affichent ici une fois effectués : quand le train signale son passage à vos arrêts, ou quand vous les confirmez."
          }
        }
      }
    },
