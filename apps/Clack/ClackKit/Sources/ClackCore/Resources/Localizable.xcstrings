{
  "sourceLanguage" : "en",
  "strings" : {
    "about.co2Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance along the track × (comparison factor − train factor). Factors are well-to-wheel g CO₂e per passenger-km from IVL Swedish Environmental Research Institute, report U11173 (2026). Norwegian and Finnish trips use the same factors for now: we haven’t yet checked a Norwegian or a Finnish source."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sträcka längs spåret × (jämförelsefaktor − tågfaktor). Faktorerna är well-to-wheel g CO₂e per personkilometer från IVL Svenska Miljöinstitutet, rapport U11173 (2026). Norska och finska resor räknas tills vidare med samma faktorer: vi har inte kontrollerat någon norsk eller finsk källa än."
          }
        }
      }
    },
    "about.co2Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How we calculate CO₂"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så räknar vi CO₂"
          }
        }
      }
    },
    "about.delaysBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green: on time or early. Yellow: 1–15 min late. Amber: 16–30 min. Red: more than 30 min. A train counts as on time in your stats when it arrives at most {{max}} minutes late."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grönt: i tid eller tidigt. Gult: 1–15 min sent. Orange: 16–30 min. Rött: mer än 30 min. I din statistik räknas ett tåg som i tid om det kommer fram högst {{max}} minuter sent."
          }
        }
      }
    },
    "about.delaysTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delay colours"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förseningsfärger"
          }
        }
      }
    },
    "about.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clack logs the trains you ride. Timetables, actual times and maps come from open data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clack loggar tågen du åker. Tidtabeller, faktiska tider och kartor kommer från öppna data."
          }
        }
      }
    },
    "about.sources.digitraffic" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitraffic (Fintraffic, Finland), CC BY 4.0: rail timetables, stations, live positions, delays, actual times and departure boards. Source: Fintraffic / digitraffic.fi, license CC 4.0 BY"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitraffic (Fintraffic, Finland), CC BY 4.0: tidtabeller, stationer, livepositioner, förseningar, faktiska tider och avgångstavlor för tåg. Source: Fintraffic / digitraffic.fi, license CC 4.0 BY"
          }
        }
      }
    },
    "about.sources.entur" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entur (Norway), under the Norwegian Licence for Open Government Data (NLOD): rail timetables, stations, live positions, delays, actual times and departure boards."
