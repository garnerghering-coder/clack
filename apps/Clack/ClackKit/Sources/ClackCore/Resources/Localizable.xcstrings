    "about.sources.onboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On board: catering and same-day notices come from Trafikverket for each departure; everything marked \"Typically\" comes from the operator’s own pages, with the date it was checked."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombord: servering och dagens avvikelser kommer från Trafikverket för varje avgång; allt som står under \"Brukar finnas\" kommer från operatörens egna sidor, med datum då det kontrollerades."
          }
        }
      }
    },
    "about.sources.osm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
