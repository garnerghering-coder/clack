    "privacy.usageBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unless you turn it off in Settings: anonymous daily counts of which screens and features are used, which station pairs are added, which errors show, and Apple’s crash reports. They go only to our own server, as totals per day with no code, device or anything that says who you are, so we can see what to improve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du inte stänger av det i Inställningar: anonyma dagliga antal av vilka vyer och funktioner som används, vilka stationspar som läggs till, vilka fel som visas, och Apples kraschrapporter. De går bara till vår egen server, som summor per dag utan kod, enhet eller något som säger vem du är, så att vi ser vad som behöver bli bättre."
          }
        }
      }
    },
