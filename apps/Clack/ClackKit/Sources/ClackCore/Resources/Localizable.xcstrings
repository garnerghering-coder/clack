        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platforms and shops only; no routes between levels yet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara plattformar och butiker; inga vägar mellan våningarna än."
