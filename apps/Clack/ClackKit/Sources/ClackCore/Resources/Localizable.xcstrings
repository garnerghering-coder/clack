    "privacy.alertsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you turn alerts on: Apple’s address for your phone (a long code Apple gives the app so it can be sent notifications), kept with your random code and your alert settings. It is used only to send you the alerts you chose and to update the trip card on your lock screen, and it is removed when you turn alerts off or delete your data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara om du slår på notiser: Apples adress till din telefon (en lång kod som Apple ger appen så att den kan skicka notiser), sparad tillsammans med din slumpkod och dina notisinställningar. Den används bara för att skicka de notiser du valt och för att uppdatera reskortet på din låsskärm, och den tas bort när du stänger av notiser eller raderar dina data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun hvis du slår beskeder til: Apples adresse til din telefon (en lang kode, Apple giver appen, så den kan få sendt notifikationer), gemt sammen med din tilfældige kode og dine indstillinger for beskeder. Den bruges kun til at sende dig de beskeder, du har valgt, og til at opdatere turkortet på din låseskærm, og den fjernes, når du slår beskeder fra eller sletter dine data."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bare hvis du slår på varsler: Apples adresse for telefonen din (en lang kode Apple gir appen så den kan få varsler), lagret sammen med den tilfeldige koden din og varslingsinnstillingene dine. Den brukes bare til å sende deg varslene du valgte og til å oppdatere turkortet på låseskjermen, og den fjernes når du slår av varsler eller sletter dataene dine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vain jos otat ilmoitukset käyttöön: Applen osoite puhelimellesi (pitkä koodi, jonka Apple antaa sovellukselle, jotta sille voidaan lähettää ilmoituksia), tallennettuna satunnaisen koodisi ja ilmoitusasetustesi kanssa. Sitä käytetään vain valitsemiesi ilmoitusten lähettämiseen ja lukitusnäytön matkakortin päivittämiseen, ja se poistetaan, kun poistat ilmoitukset käytöstä tai poistat tietosi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur wenn du Mitteilungen einschaltest: Apples Adresse für dein Telefon (ein langer Code, den Apple der App gibt, damit ihr Mitteilungen geschickt werden können), gespeichert mit deinem Zufallscode und deinen Mitteilungseinstellungen. Sie wird nur genutzt, um dir die gewählten Mitteilungen zu schicken und die Fahrtkarte auf deinem Sperrbildschirm zu aktualisieren, und sie wird entfernt, wenn du Mitteilungen ausschaltest oder deine Daten löschst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tylko jeśli włączysz powiadomienia: adres Apple dla twojego telefonu (długi kod, który Apple przekazuje aplikacji, aby mogła wysyłać powiadomienia), przechowywany razem z twoim losowym kodem i ustawieniami powiadomień. Służy wyłącznie do wysyłania wybranych przez ciebie powiadomień i aktualizowania karty przejazdu na ekranie blokady; jest usuwany, gdy wyłączysz powiadomienia lub usuniesz swoje dane."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seulement si vous activez les alertes : l’adresse Apple de votre téléphone (un long code qu’Apple donne à l’app pour qu’elle puisse recevoir des notifications), conservée avec votre code aléatoire et vos réglages d’alertes. Elle sert uniquement à vous envoyer les alertes choisies et à mettre à jour la carte du trajet sur votre écran verrouillé, et elle est supprimée quand vous désactivez les alertes ou supprimez vos données."
          }
        }
      }
    },
