    "firstRun.log" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put in the train you’re taking: Clack tells you if it’s late, which platform, and where it is. Every train you ride goes into your Passport."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg in tåget du ska åka: Clack säger om det är sent, vilket spår, och var det är. Varje tåg du åker hamnar i ditt pass."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indtast det tog, du tager: Clack fortæller dig, om det er forsinket, hvilket spor og hvor det er. Hvert tog, du kører med, kommer i dit pas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Legg inn toget du tar: Clack sier fra om det er forsinket, hvilket spor og hvor det er. Hvert tog du reiser med, havner i passet ditt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisää juna, jolla matkustat: Clack kertoo, onko se myöhässä, miltä raiteelta se lähtee ja missä se on. Jokainen junamatkasi päätyy passiisi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gib den Zug ein, mit dem du fährst: Clack sagt dir, ob er verspätet ist, welches Gleis und wo er ist. Jeder Zug, mit dem du fährst, kommt in deinen Pass."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wpisz pociąg, którym jedziesz: Clack powie ci, czy jest opóźniony, z którego peronu odjeżdża i gdzie jest. Każdy twój przejazd trafia do Paszportu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indiquez le train que vous prenez : Clack vous dit s’il est en retard, sur quelle voie et où il se trouve. Chaque train que vous prenez rejoint votre Passeport."
          }
        }
      }
    },
