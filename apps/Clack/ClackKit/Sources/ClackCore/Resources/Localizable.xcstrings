    "privacy.deletionBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data stays until you delete it. \"Delete my data\" in Settings removes everything our server has under your code at once, and the copies on your phone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina uppgifter finns kvar tills du raderar dem. \"Radera mina uppgifter\" i Inställningar tar bort allt vår server har under din kod direkt, och kopiorna i telefonen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dine data bliver, indtil du sletter dem. \"Slet mine data\" i Indstillinger fjerner med det samme alt, hvad vores server har under din kode, og kopierne på din telefon."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dataene dine blir liggende til du sletter dem. «Slett dataene mine» i Innstillinger fjerner med én gang alt serveren vår har under koden din, og kopiene på telefonen din."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tietosi säilyvät, kunnes poistat ne. Asetusten \"Poista tietoni\" poistaa kerralla kaiken, mitä palvelimellamme on koodisi alla, sekä puhelimessasi olevat kopiot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Daten bleiben, bis du sie löschst. „Meine Daten löschen“ in den Einstellungen entfernt sofort alles, was unser Server unter deinem Code hat, und die Kopien auf deinem Telefon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje dane zostają, dopóki ich nie usuniesz. „Usuń moje dane” w Ustawieniach od razu usuwa wszystko, co nasz serwer ma pod twoim kodem, oraz kopie na telefonie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vos données restent jusqu’à ce que vous les supprimiez. « Supprimer mes données » dans les Réglages efface d’un coup tout ce que notre serveur détient sous votre code, ainsi que les copies sur votre téléphone."
          }
        }
      }
    },
