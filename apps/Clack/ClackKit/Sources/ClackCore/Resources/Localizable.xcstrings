    "about.sources.onboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On board: catering and same-day notices come from Trafikverket for each departure; everything marked \"Typically\" comes from the operator’s own pages, with the date it was checked."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombord: servering och dagens avvikelser kommer från Trafikverket för varje avgång; allt som står under \"Brukar finnas\" kommer från tågbolagets egna sidor, med datum då det kontrollerades."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om bord: servering og meddelelser for dagen kommer fra Trafikverket for hver afgang; alt markeret \"Typisk\" kommer fra operatørens egne sider med datoen, det blev tjekket."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om bord: servering og meldinger for samme dag kommer fra Trafikverket for hver avgang; alt merket «Vanligvis» kommer fra operatørens egne sider, med datoen det ble sjekket."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Junassa: ravintolapalvelut ja saman päivän tiedotteet tulevat Trafikverketiltä jokaiselle lähdölle; kaikki ”Yleensä”-merkityt tiedot tulevat liikennöitsijän omilta sivuilta, tarkistuspäivän kera."
          }
        },
