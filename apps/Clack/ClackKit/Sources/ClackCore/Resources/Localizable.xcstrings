          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poistetaanko kaikki matkasi, seuratut junat ja asetukset ja käynnistetäänkö Clack kuin et olisi koskaan avannut sitä? Tätä ei voi perua."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle deine Fahrten, gefolgten Züge und Einstellungen löschen und Clack starten, als hättest du es nie geöffnet? Das kann nicht rückgängig gemacht werden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usunąć wszystkie twoje przejazdy, obserwowane pociągi i ustawienia oraz uruchomić Clack jak przy pierwszym otwarciu? Tego nie można cofnąć."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer tous vos trajets, trains suivis et réglages, et démarrer Clack comme si vous ne l’aviez jamais ouvert ? Action irréversible."
          }
        }
      }
    },
