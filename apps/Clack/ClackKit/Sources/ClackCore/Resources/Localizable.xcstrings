    "network.explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Late means {{min}} minutes or more. A stretch shows here when at least two trains are on it and most of them are late. Reasons are the operators' own; from Trafikverket and Fintraffic so far."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent betyder {{min}} minuter eller mer. En sträcka visas här när minst två tåg är på den och de flesta är sena. Orsakerna är trafikbolagens egna; än så länge från Trafikverket och Fintraffic."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forsinket betyder {{min}} minutter eller mere. En strækning vises her, når mindst to tog er på den, og de fleste af dem er forsinkede. Årsagerne er operatørernes egne; indtil videre fra Trafikverket og Fintraffic."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Forsinket betyr {{min}} minutter eller mer. En strekning vises her når minst to tog er på den og de fleste av dem er forsinket. Årsakene er operatørenes egne; foreløpig fra Trafikverket og Fintraffic."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Myöhässä tarkoittaa vähintään {{min}} minuuttia. Rataosuus näkyy tässä, kun sillä on vähintään kaksi junaa ja suurin osa niistä on myöhässä. Syyt ovat liikennöitsijöiden omia; toistaiseksi Trafikverketiltä ja Fintrafficilta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verspätet heißt {{min}} Minuten oder mehr. Ein Abschnitt erscheint hier, wenn mindestens zwei Züge darauf sind und die meisten verspätet sind. Die Gründe sind die der Betreiber; bisher von Trafikverket und Fintraffic."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opóźniony oznacza {{min}} min lub więcej. Odcinek pojawia się tutaj, gdy jadą po nim co najmniej dwa pociągi i większość z nich jest opóźniona. Przyczyny podają sami przewoźnicy; na razie z Trafikverket i Fintraffic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En retard signifie {{min}} minutes ou plus. Un tronçon s’affiche ici quand au moins deux trains y circulent et que la plupart sont en retard. Les raisons sont celles des opérateurs ; pour l’instant de Trafikverket et Fintraffic."
          }
        }
      }
    },
