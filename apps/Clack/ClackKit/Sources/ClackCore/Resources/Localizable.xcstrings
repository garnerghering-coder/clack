        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under EU rules, arriving 60–119 min late can give you 25% of the ticket price back."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enligt EU:s regler kan 60–119 min försenad ankomst ge 25 % av biljettpriset tillbaka."
          }
        }
      }
    },
    "disruption.rightsEu_compensation_50" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under EU rules, arriving 2 hours or more late can give you 50% of the ticket price back."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enligt EU:s regler kan 2 timmar eller mer försenad ankomst ge 50 % av biljettpriset tillbaka."
