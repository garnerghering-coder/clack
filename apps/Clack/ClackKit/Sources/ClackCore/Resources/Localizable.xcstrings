    "add.noEarlierThatDay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing before {{time}} on {{day}} in the timetable. That can mean works or a reduced timetable: check with the operator before you travel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget före {{time}} {{day}} i tidtabellen. Det kan betyda banarbete eller en reducerad tidtabell: kontrollera med tågbolaget innan du reser."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intet før {{time}} {{day}} i køreplanen. Det kan betyde sporarbejde eller en reduceret køreplan: tjek med operatøren, før du rejser."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingenting før {{time}} {{day}} i rutetabellen. Det kan bety arbeid på sporet eller redusert rutetabell: sjekk med operatøren før du reiser."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aikataulussa ei ole mitään ennen klo {{time}} ({{day}}). Syynä voivat olla ratatyöt tai supistettu aikataulu: tarkista liikennöitsijältä ennen matkaa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laut Fahrplan am {{day}} nichts vor {{time}}. Das kann Bauarbeiten oder einen reduzierten Fahrplan bedeuten: frag vor der Fahrt beim Betreiber nach."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "W rozkładzie nie ma nic przed {{time}} w dniu {{day}}. Może to oznaczać prace lub ograniczony rozkład: sprawdź u przewoźnika przed podróżą."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rien avant {{time}} le {{day}} dans les horaires. Cela peut signifier des travaux ou un service réduit : renseignez-vous auprès de l’opérateur avant de voyager."
          }
        }
      }
    },
