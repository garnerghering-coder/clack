    "disruption.rightsEu" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longer journeys fall under EU rules: arriving 60 min or more late gives compensation (25%, or 50% from 2 hours)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Längre resor omfattas av EU:s regler: 60 min eller mer försenad ankomst ger ersättning (25 %, eller 50 % från 2 timmar)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Længere rejser er omfattet af EU-reglerne: ankomst 60 min eller mere for sent giver kompensation (25 %, eller 50 % fra 2 timer)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lengre reiser faller inn under EUs regler: kommer du fram 60 min eller mer forsinket, får du erstatning (25 %, eller 50 % fra 2 timer)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pidemmät matkat kuuluvat EU-sääntöjen piiriin: vähintään 60 min myöhästyminen perillä oikeuttaa korvaukseen (25 %, tai 50 % 2 tunnista alkaen)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Längere Fahrten fallen unter EU-Regeln: Ab 60 min Verspätung bei Ankunft gibt es eine Entschädigung (25 %, ab 2 Stunden 50 %)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dłuższe podróże podlegają przepisom UE: przyjazd z opóźnieniem 60 min lub większym daje odszkodowanie (25%, a od 2 godzin 50%)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les trajets plus longs relèvent des règles de l’UE : une arrivée avec 60 min de retard ou plus donne droit à une indemnisation (25 %, ou 50 % à partir de 2 heures)."
          }
        }
      }
    },
