    "liveMap.notRunningBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may not have started yet, may have finished for the day, or doesn’t run today. It will show here when it does."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det har kanske inte börjat än, har gått klart för dagen eller går inte i dag. Det syns här när det går."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det er måske ikke startet endnu, er færdigt for i dag, eller kører ikke i dag. Det vises her, når det kører."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Det har kanskje ikke startet ennå, er ferdig for dagen eller går ikke i dag. Det vises her når det går."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ei ehkä ole vielä lähtenyt, on jo päättänyt päivänsä tai ei kulje tänään. Se näkyy täällä, kun se kulkee."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vielleicht ist er noch nicht losgefahren, hat seine Fahrt für heute beendet oder fährt heute nicht. Er erscheint hier, sobald er fährt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mógł jeszcze nie wyruszyć, mógł już zakończyć kursowanie na dziś albo nie kursuje dzisiaj. Pojawi się tutaj, gdy wyruszy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il n’a peut-être pas encore commencé, a peut-être terminé sa journée, ou ne circule pas aujourd’hui. Il s’affichera ici quand il circulera."
          }
        }
      }
