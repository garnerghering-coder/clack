    "manual.introMore" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norway before yesterday, a heritage run, a train abroad. The route is drawn along the rail network."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norge före i går, ett museitåg, ett tåg utomlands. Sträckan ritas längs järnvägsnätet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Norge før i går, en veterantur, et tog i udlandet. Ruten tegnes langs jernbanenettet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Norge før i går, en veterantogtur, et tog i utlandet. Ruten tegnes langs jernbanenettet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Norja ennen eilistä, museojuna, juna ulkomailla. Reitti piirretään rataverkkoa pitkin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Norwegen vor gestern, eine Museumsfahrt, ein Zug im Ausland. Der Laufweg wird entlang des Bahnnetzes gezeichnet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Norwegia sprzed przedwczoraj, przejazd pociągiem retro, pociąg za granicą. Trasa jest rysowana wzdłuż sieci kolejowej."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La Norvège avant hier, un train historique, un train à l’étranger. L’itinéraire est tracé le long du réseau ferré."
          }
        }
      }
    },
