    "wallet.pass.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A copy of the code on the ticket you shared to Clack. Keep the original ticket too: the conductor may ask for it, and for ID if the ticket says so."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kopia av koden på biljetten du delade till Clack. Ha kvar originalbiljetten också: konduktören kan be om den, och om legitimation om biljetten kräver det."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kopi af koden på den billet, du delte til Clack. Behold også den originale billet: togpersonalet kan bede om den, og om ID, hvis billetten siger det."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En kopi av koden på billetten du delte til Clack. Ta vare på den opprinnelige billetten også: konduktøren kan be om den, og om legitimasjon hvis billetten sier det."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopio Clackiin jakamasi lipun koodista. Säilytä myös alkuperäinen lippu: konduktööri voi pyytää sitä, ja henkilöllisyystodistusta, jos lipussa niin lukee."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Kopie des Codes auf dem Ticket, das du mit Clack geteilt hast. Behalte auch das Original: Das Zugpersonal kann danach fragen, und nach einem Ausweis, wenn das Ticket es verlangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopia kodu z biletu udostępnionego do Clack. Zachowaj też oryginalny bilet: konduktor może o niego poprosić, a także o dokument tożsamości, jeśli bilet tego wymaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une copie du code du billet que vous avez partagé avec Clack. Gardez aussi le billet original : le contrôleur peut le demander, ainsi qu’une pièce d’identité si le billet l’indique."
          }
        }
      }
    },
