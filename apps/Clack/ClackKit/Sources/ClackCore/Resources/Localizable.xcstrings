    "riders.ask.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone can tell Clack where along the track this train is, so everyone sees it where it really is. Only the train, how far along its stretch, its speed and the time: no coordinates and no account id. You can change this in Settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen kan berätta för Clack var längs spåret det här tåget är, så att alla ser det där det verkligen är. Bara tåget, hur långt längs sträckan, farten och tiden: inga koordinater och inget konto-id. Du kan ändra det i Inställningar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Din telefon kan fortælle Clack, hvor langs sporet dette tog er, så alle ser det, hvor det virkelig er. Kun toget, hvor langt det er nået på sin strækning, dets fart og tidspunktet: ingen koordinater og intet konto-id. Du kan ændre det i Indstillinger."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Telefonen din kan fortelle Clack hvor langs sporet dette toget er, så alle ser det der det faktisk er. Bare toget, hvor langt det har kommet på strekningen, farten og tiden: ingen koordinater og ingen konto-id. Du kan endre dette i Innstillinger."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puhelimesi voi kertoa Clackille, missä kohtaa rataa tämä juna on, jotta kaikki näkevät sen siellä, missä se oikeasti on. Vain juna, kuinka pitkällä se on rataosuudellaan, sen nopeus ja aika: ei koordinaatteja eikä tilin tunnistetta. Voit muuttaa tätä asetuksissa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Telefon kann Clack sagen, wo auf der Strecke dieser Zug ist, damit alle ihn dort sehen, wo er wirklich ist. Nur der Zug, wie weit er auf seinem Abschnitt ist, seine Geschwindigkeit und die Uhrzeit: keine Koordinaten und keine Konto-ID. Du kannst das in den Einstellungen ändern."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twój telefon może przekazać Clack, w którym miejscu toru jest ten pociąg, aby wszyscy widzieli go tam, gdzie naprawdę jest. Tylko pociąg, jak daleko jest na swoim odcinku, jego prędkość i godzina: bez współrzędnych i bez identyfikatora konta. Możesz to zmienić w Ustawieniach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre téléphone peut indiquer à Clack où se trouve ce train sur la voie, pour que tout le monde le voie là où il est vraiment. Seulement le train, où il en est sur son tronçon, sa vitesse et l’heure : aucune coordonnée et aucun identifiant de compte. Vous pouvez modifier ce choix dans les Réglages."
          }
        }
      }
    },
