    },
    "about.sources.stationMaps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Station maps: drafted from OpenStreetMap (© OpenStreetMap contributors) and edited by hand; the map data is offered under the ODbL like OpenStreetMap itself. Walking times are worked out from the map, not timed on site. Opening hours are as listed and may differ on holidays."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stationskartor: utkast från OpenStreetMap (© OpenStreetMaps bidragsgivare), handredigerade; kartdatan erbjuds under ODbL precis som OpenStreetMap. Gångtiderna räknas fram ur kartan, de är inte uppmätta på plats. Öppettider enligt uppgift; kan avvika på helgdagar."
          }
        }
      }
    },
