    "about.delaysBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green: on time or early. Yellow: 1–15 min late. Amber: 16–30 min. Red: more than 30 min. A train counts as on time in your stats when it arrives at most {{max}} minutes late."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grönt: i tid eller tidigt. Gult: 1–15 min sent. Orange: 16–30 min. Rött: mer än 30 min. I din statistik räknas ett tåg som i tid om det kommer fram högst {{max}} minuter sent."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grøn: til tiden eller før tid. Gul: 1–15 min forsinket. Rav: 16–30 min. Rød: mere end 30 min. Et tog tæller som til tiden i din statistik, når det ankommer højst {{max}} minutter for sent."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grønn: i rute eller tidlig. Gul: 1–15 min forsinket. Oransje: 16–30 min. Rød: mer enn 30 min. Et tog regnes som i rute i statistikken din når det kommer fram høyst {{max}} minutter forsinket."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vihreä: ajallaan tai etuajassa. Keltainen: 1–15 min myöhässä. Oranssi: 16–30 min. Punainen: yli 30 min. Tilastoissasi juna on ajallaan, kun se saapuu enintään {{max}} minuuttia myöhässä."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Grün: pünktlich oder früher. Gelb: 1–15 min verspätet. Orange: 16–30 min. Rot: mehr als 30 min. In deiner Statistik gilt ein Zug als pünktlich, wenn er höchstens {{max}} Minuten verspätet ankommt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zielony: o czasie lub przed czasem. Żółty: 1–15 min opóźnienia. Pomarańczowy: 16–30 min. Czerwony: ponad 30 min. W statystykach pociąg liczy się jako punktualny, jeśli przyjeżdża z opóźnieniem najwyżej {{max}} min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vert : à l’heure ou en avance. Jaune : 1 à 15 min de retard. Orange : 16 à 30 min. Rouge : plus de 30 min. Dans vos statistiques, un train compte comme à l’heure s’il arrive avec au plus {{max}} minutes de retard."
          }
        }
      }
    },
