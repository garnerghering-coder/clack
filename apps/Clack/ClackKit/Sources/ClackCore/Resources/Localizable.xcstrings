    "privacy.reportsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you tap “Report wrong data” on a trip, we keep that report with the trip: what you wrote, what the screen showed and what our server had for the train at that moment, so the error can be found. It is deleted with the trip or with your data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du trycker på ”Anmäl fel uppgift” på en resa sparar vi den anmälan med resan: det du skrev, det skärmen visade och det vår server hade om tåget just då, så att felet kan hittas. Den raderas med resan eller med dina data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis du trykker på “Rapportér forkerte data” på en tur, gemmer vi rapporten med turen: hvad du skrev, hvad skærmen viste, og hvad vores server havde om toget i det øjeblik, så fejlen kan findes. Den slettes med turen eller med dine data."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis du trykker på «Meld fra om feil data» på en tur, lagrer vi meldingen sammen med turen: hva du skrev, hva skjermen viste og hva serveren vår hadde om toget i det øyeblikket, så feilen kan finnes. Den slettes med turen eller med dataene dine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos napautat matkalla ”Ilmoita virheellisestä tiedosta”, säilytämme ilmoituksen matkan yhteydessä: mitä kirjoitit, mitä näytöllä näkyi ja mitä tietoja palvelimellamme oli junasta sillä hetkellä, jotta virhe löytyy. Se poistetaan matkan tai tietojesi mukana."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du bei einer Fahrt auf „Falsche Daten melden“ tippst, speichern wir die Meldung mit der Fahrt: was du geschrieben hast, was der Bildschirm zeigte und was unser Server in dem Moment für den Zug hatte, damit der Fehler gefunden werden kann. Sie wird mit der Fahrt oder mit deinen Daten gelöscht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli stukniesz „Zgłoś błędne dane” przy przejeździe, przechowujemy to zgłoszenie razem z przejazdem: co napiszesz, co pokazywał ekran i co nasz serwer miał o pociągu w tym momencie, aby można było znaleźć błąd. Jest usuwane razem z przejazdem lub twoimi danymi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si vous touchez « Signaler une erreur » sur un trajet, nous conservons ce signalement avec le trajet : ce que vous avez écrit, ce que l’écran affichait et ce que notre serveur avait pour le train à ce moment-là, afin de trouver l’erreur. Il est supprimé avec le trajet ou avec vos données."
          }
        }
      }
    },
    "privacy.reportsTitle" : {
