    "share.privacyMore" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No times, ticket details, train numbers or where you are now. Nothing leaves your device until you save or share it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga tider, biljettuppgifter, tågnummer eller var du är nu. Inget lämnar enheten förrän du sparar eller delar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen tider, billetoplysninger, tognumre eller hvor du er nu. Intet forlader din enhed, før du gemmer eller deler det."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen tider, billettdetaljer, tognumre eller hvor du er nå. Ingenting forlater enheten før du lagrer eller deler det."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ei aikoja, lipun tietoja, junien numeroita eikä nykyistä sijaintiasi. Mikään ei lähde laitteeltasi ennen kuin tallennat tai jaat sen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine Zeiten, Ticketdaten, Zugnummern oder dein aktueller Standort. Nichts verlässt dein Gerät, bevor du es sicherst oder teilst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bez godzin, danych biletu, numerów pociągów ani twojej obecnej lokalizacji. Nic nie opuszcza urządzenia, dopóki tego nie zapiszesz lub nie udostępnisz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ni heures, ni détails du billet, ni numéros de train, ni l’endroit où vous êtes. Rien ne quitte votre appareil tant que vous ne l’enregistrez pas ou ne le partagez pas."
          }
        }
      }
    },
