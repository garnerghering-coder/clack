    "about.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clack logs the trains you ride. Timetables, actual times and maps come from open data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clack loggar tågen du åker. Tidtabeller, faktiska tider och kartor kommer från öppna data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack logger de tog, du kører med. Køreplaner, faktiske tider og kort kommer fra åbne data."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack logger togene du reiser med. Rutetider, faktiske tider og kart kommer fra åpne data."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack kirjaa junat, joilla matkustat. Aikataulut, toteutuneet ajat ja kartat tulevat avoimesta datasta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack hält fest, mit welchen Zügen du fährst. Fahrpläne, Ist-Zeiten und Karten stammen aus offenen Daten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack zapisuje pociągi, którymi jeździsz. Rozkłady, rzeczywiste godziny i mapy pochodzą z otwartych danych."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Clack enregistre les trains que vous prenez. Les horaires, les heures réelles et les cartes proviennent de données ouvertes."
          }
        }
      }
    },
