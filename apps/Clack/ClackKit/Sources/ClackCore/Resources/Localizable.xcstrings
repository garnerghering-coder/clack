    "passport.co2Method" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An estimate: distance × each country's published train figure (IVL for Sweden; Vy, VR and DSB's government data elsewhere), against a Swedish car or flight."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uppskattning: sträcka × varje lands publicerade siffra för tåg (IVL för Sverige; Vy, VR och DSB:s statliga uppgifter annars), jämfört med en svensk bil eller flygresa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et skøn: distance × hvert lands offentliggjorte togtal (IVL for Sverige; Vy, VR og DSB's offentlige data andre steder) mod en svensk bil eller et fly."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et anslag: distanse × hvert lands publiserte tall for tog (IVL for Sverige; Vy, VR og DSBs offentlige data ellers), mot en svensk bil eller et fly."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arvio: matka × kunkin maan julkaisema junan luku (Ruotsissa IVL; muualla Vy, VR ja DSB:n valtion data), verrattuna ruotsalaiseen autoon tai lentoon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Schätzung: Strecke × der veröffentlichte Zugwert jedes Landes (IVL für Schweden; sonst die Behördendaten von Vy, VR und DSB), verglichen mit einem schwedischen Auto oder Flug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szacunek: dystans × opublikowany wskaźnik dla pociągów w każdym kraju (IVL dla Szwecji; dane rządowe Vy, VR i DSB w pozostałych), w porównaniu ze szwedzkim samochodem lub samolotem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une estimation : distance × le chiffre publié pour les trains de chaque pays (IVL pour la Suède ; ailleurs, les données publiques de Vy, VR et DSB), comparée à une voiture ou un avion suédois."
          }
        }
      }
