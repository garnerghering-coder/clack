    "privacy.notCollectedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No name, email, phone number, contacts, photos or payment details. No advertising or third-party analytics tools, and no tracking across other apps or websites."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget namn, ingen e-post, inget telefonnummer, inga kontakter, bilder eller betaluppgifter. Inga reklam- eller analysverktyg från andra, och ingen spårning i andra appar eller på webbplatser."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intet navn, ingen e-mail, intet telefonnummer, ingen kontakter, fotos eller betalingsoplysninger. Ingen reklame eller analyseværktøjer fra tredjeparter og ingen sporing på tværs af andre apps eller websteder."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ikke navn, e-post, telefonnummer, kontakter, bilder eller betalingsopplysninger. Ingen reklame eller analyseverktøy fra tredjeparter, og ingen sporing på tvers av andre apper eller nettsteder."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ei nimeä, sähköpostia, puhelinnumeroa, yhteystietoja, kuvia eikä maksutietoja. Ei mainonta- eikä kolmannen osapuolen analytiikkatyökaluja, eikä seurantaa muissa sovelluksissa tai verkkosivustoilla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein Name, keine E-Mail, keine Telefonnummer, keine Kontakte, Fotos oder Zahlungsdaten. Keine Werbung oder Analysewerkzeuge Dritter und kein Tracking über andere Apps oder Websites."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Żadnego imienia, adresu e-mail, numeru telefonu, kontaktów, zdjęć ani danych płatniczych. Żadnych reklam ani zewnętrznych narzędzi analitycznych i żadnego śledzenia w innych aplikacjach czy na stronach internetowych."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ni nom, ni e-mail, ni numéro de téléphone, ni contacts, ni photos, ni données de paiement. Aucun outil de publicité ou d’analyse tiers, et aucun pistage entre d’autres apps ou sites web."
          }
        }
      }
    },
