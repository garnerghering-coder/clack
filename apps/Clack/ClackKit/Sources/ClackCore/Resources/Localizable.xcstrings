    "journey.addOrFollowNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add to trips makes it yours: live times, alerts and your Passport. Follow only watches it, without adding it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till i resor gör den till din: realtid, aviseringar och ditt pass. Följ bara bevakar den, utan att lägga till."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tilføj til rejser gør den til din: live-tider, beskeder og dit pas. Følg holder bare øje med den uden at tilføje den."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Legg til i turer gjør den til din: sanntid, varsler og passet ditt. Følg bare følger med på den, uten å legge den til."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lisää matkoihin tekee siitä sinun: reaaliaikaiset ajat, ilmoitukset ja passi. Seuraa vain seuraa sitä lisäämättä."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Zu Fahrten hinzufügen“ macht sie zu deiner: Live-Zeiten, Mitteilungen und dein Pass. „Folgen“ beobachtet sie nur, ohne sie hinzuzufügen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dodaj do podróży sprawia, że jest twoja: godziny na żywo, powiadomienia i Paszport. Obserwuj tylko ją śledzi, bez dodawania."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajouter aux trajets le rend vôtre : heures en direct, alertes et Passeport. Suivre permet seulement de le surveiller, sans l’ajouter."
          }
        }
      }
    },
