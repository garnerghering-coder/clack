    "settings.walkModeAutoHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While you change trains, the station map starts walk mode by itself once you are within 150 m of the station."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du byter tåg startar stationskartan gångläget av sig självt när du är inom 150 m från stationen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mens du skifter tog, starter stationskortet selv gåtilstand, når du er inden for 150 m af stationen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
