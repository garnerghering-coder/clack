    "about.sources.stationMaps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Station maps: drafted from OpenStreetMap (© OpenStreetMap contributors) and edited by hand; the map data is offered under the ODbL like OpenStreetMap itself. Walking times are worked out from the map, not timed on site. Opening hours are as listed and may differ on holidays."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stationskartor: utkast från OpenStreetMap (© OpenStreetMaps bidragsgivare), handredigerade; kartdatan erbjuds under ODbL precis som OpenStreetMap. Gångtiderna räknas fram ur kartan, de är inte uppmätta på plats. Öppettider enligt uppgift; kan avvika på helgdagar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stationskort: udkast fra OpenStreetMap (© OpenStreetMap-bidragydere) og redigeret i hånden; kortdata tilbydes under ODbL ligesom OpenStreetMap selv. Gåtider er beregnet ud fra kortet, ikke målt på stedet. Åbningstider er som oplyst og kan afvige på helligdage."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stasjonskart: laget ut fra OpenStreetMap (© OpenStreetMap-bidragsytere) og redigert for hånd; kartdataene tilbys under ODbL, som OpenStreetMap selv. Gangtider er regnet ut fra kartet, ikke målt på stedet. Åpningstider er slik de er oppgitt og kan avvike på helligdager."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asemakartat: luonnosteltu OpenStreetMapista (© OpenStreetMap-tekijät) ja muokattu käsin; karttadata on saatavilla ODbL-lisenssillä kuten OpenStreetMap itse. Kävelyajat on laskettu kartasta, ei mitattu paikan päällä. Aukioloajat ovat ilmoitetut, ja ne voivat poiketa pyhäpäivinä."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bahnhofspläne: aus OpenStreetMap entworfen (© OpenStreetMap-Mitwirkende) und von Hand bearbeitet; die Kartendaten stehen wie OpenStreetMap selbst unter der ODbL. Gehzeiten sind aus der Karte berechnet, nicht vor Ort gemessen. Öffnungszeiten wie angegeben, an Feiertagen evtl. abweichend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mapy stacji: opracowane na podstawie OpenStreetMap (© współtwórcy OpenStreetMap) i poprawione ręcznie; dane map są udostępniane na licencji ODbL, tak jak samo OpenStreetMap. Czasy przejścia są wyliczone z mapy, a nie zmierzone na miejscu. Godziny otwarcia są podane zgodnie z ogłoszeniami i mogą się różnić w święta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plans de gare : esquissés à partir d’OpenStreetMap (© contributeurs OpenStreetMap) et retouchés à la main ; les données de la carte sont proposées sous licence ODbL, comme OpenStreetMap. Les temps de marche sont calculés d’après la carte, pas chronométrés sur place. Les horaires d’ouverture sont ceux annoncés et peuvent varier les jours fériés."
          }
        }
      }
    },
