    "alertsPrompt.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reminder before it leaves, the platform when it’s announced, and delays, changes and cancellations, even when Clack is closed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En påminnelse innan det går, spåret när det meddelas, och förseningar, byten och inställda tåg, även när Clack är stängd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En påmindelse inden afgang, sporet når det meldes, og forsinkelser, ændringer og aflysninger, også når Clack er lukket."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En påminnelse før det går, sporet når det er kjent, og forsinkelser, endringer og innstillinger, også når Clack er lukket."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muistutus ennen lähtöä, raide kun se ilmoitetaan sekä myöhästymiset, muutokset ja peruutukset, myös kun Clack on suljettu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Erinnerung vor der Abfahrt, das Gleis, sobald es angekündigt ist, und Verspätungen, Änderungen und Ausfälle, auch wenn Clack geschlossen ist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przypomnienie przed odjazdem, peron, gdy zostanie ogłoszony, oraz opóźnienia, zmiany i odwołania, nawet gdy Clack jest zamknięty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un rappel avant le départ, la voie dès qu’elle est annoncée, ainsi que les retards, modifications et suppressions, même quand Clack est fermé."
          }
        }
      }
    },
