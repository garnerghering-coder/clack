    "share.explainBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with the link sees where your train is, how late it is and when it arrives, until the journey is over. You can stop sharing any time from this button."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla med länken ser var ditt tåg är, hur sent det är och när det kommer fram, tills resan är över. Du kan sluta dela när som helst från den här knappen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle med linket kan se, hvor dit tog er, hvor forsinket det er, og hvornår det ankommer, indtil rejsen er slut. Du kan stoppe delingen når som helst med denne knap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle med lenken ser hvor toget ditt er, hvor forsinket det er og når det kommer fram, til reisen er over. Du kan slutte å dele når som helst fra denne knappen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kuka tahansa, jolla on linkki, näkee missä junasi on, kuinka paljon se on myöhässä ja milloin se saapuu, kunnes matka on ohi. Voit lopettaa jakamisen milloin tahansa tästä painikkeesta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle mit dem Link sehen, wo dein Zug ist, wie verspätet er ist und wann er ankommt, bis die Reise vorbei ist. Du kannst das Teilen jederzeit über diese Taste beenden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każdy, kto ma link, widzi, gdzie jest twój pociąg, jakie ma opóźnienie i kiedy przyjedzie, aż do końca podróży. Udostępnianie możesz zakończyć w każdej chwili tym przyciskiem."
          }
        },
