    "settings.usage.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous daily counts of which screens and features are used, which station pairs are added, which errors show, and Apple’s crash reports. Sent only to Clack’s own server, with nothing that says who you are."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyma dagliga antal: vilka vyer och funktioner som används, vilka stationspar som läggs till, vilka fel som visas, och Apples kraschrapporter. Skickas bara till Clacks egen server, utan något som säger vem du är."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme daglige optællinger af, hvilke skærme og funktioner der bruges, hvilke stationspar der tilføjes, hvilke fejl der vises, og Apples nedbrudsrapporter. Sendes kun til Clacks egen server uden noget, der siger, hvem du er."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme daglige tall for hvilke skjermer og funksjoner som brukes, hvilke stasjonspar som legges til, hvilke feil som vises, og Apples krasjrapporter. Sendes bare til Clacks egen server, uten noe som sier hvem du er."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nimettömät päivittäiset laskurit siitä, mitä näyttöjä ja toimintoja käytetään, mitä asemapareja lisätään, mitä virheitä näkyy, sekä Applen kaatumisraportit. Lähetetään vain Clackin omalle palvelimelle, ilman mitään, mikä kertoisi kuka olet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonyme tägliche Zählungen, welche Bildschirme und Funktionen genutzt werden, welche Bahnhofspaare hinzugefügt werden, welche Fehler erscheinen, und Apples Absturzberichte. Nur an Clacks eigenen Server gesendet, ohne etwas, das sagt, wer du bist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anonimowe dzienne liczniki tego, które ekrany i funkcje są używane, jakie pary stacji są dodawane, jakie błędy się pojawiają, oraz raporty awarii Apple. Wysyłane tylko na własny serwer Clack, bez niczego, co mówi, kim jesteś."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comptages quotidiens anonymes des écrans et fonctions utilisés, des paires de gares ajoutées, des erreurs affichées, et rapports de plantage d’Apple. Envoyés uniquement au serveur de Clack, sans rien qui dise qui vous êtes."
          }
        }
      }
    },
