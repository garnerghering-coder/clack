    "settings.offlineMapsNoteMore" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map along your trips in the next day and a half is saved while you’re online, so routes and the train still show with no signal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartan längs dina resor det närmaste dygnet sparas medan du är uppkopplad, så rutter och tåget syns även utan täckning."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kortet langs dine ture det næste halvanden døgn gemmes, mens du er online, så ruter og toget stadig vises uden signal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kartet langs turene dine det neste halvannet døgnet lagres mens du er på nett, så ruter og toget fortsatt vises uten dekning."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seuraavan puolentoista vuorokauden matkojesi varren kartta tallennetaan, kun olet verkossa, joten reitit ja juna näkyvät ilman kenttääkin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Karte entlang deiner Fahrten in den nächsten anderthalb Tagen wird gesichert, solange du online bist, damit Laufwege und der Zug auch ohne Empfang erscheinen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mapa wzdłuż twoich przejazdów w ciągu najbliższych półtora dnia zapisuje się, gdy masz internet, więc trasy i pociąg są widoczne także bez zasięgu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La carte le long de vos trajets des prochaines 36 heures est enregistrée tant que vous êtes en ligne, pour que les itinéraires et le train s’affichent même sans réseau."
          }
        }
      }
    },
