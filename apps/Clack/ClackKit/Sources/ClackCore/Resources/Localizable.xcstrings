    "privacy.phoneBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That random code, a copy of your trips and the maps you’ve opened so Clack works without a connection, the tickets you share to Clack (kept with their trips, removed with the trip or when you delete your data, and never uploaded), and small preferences like your theme and last tab."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slumpkoden, en kopia av dina resor och kartorna du har öppnat så att Clack fungerar utan uppkoppling, biljetterna du delar till Clack (sparade med sina resor, borttagna med resan eller när du raderar dina data, och aldrig uppladdade), och små val som tema och senaste flik."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den tilfældige kode, en kopi af dine ture og de kort, du har åbnet, så Clack virker uden forbindelse, de billetter, du deler til Clack (gemt med deres ture, fjernet med turen eller når du sletter dine data, og aldrig uploadet), og små præferencer som dit tema og din seneste fane."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den tilfeldige koden, en kopi av turene dine og kartene du har åpnet, så Clack virker uten forbindelse, billettene du deler til Clack (lagret med turene sine, fjernet med turen eller når du sletter dataene dine, og aldri lastet opp), og små innstillinger som tema og siste fane."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tuo satunnainen koodi, kopio matkoistasi ja avaamasi kartat, jotta Clack toimii ilman yhteyttä, Clackiin jakamasi liput (säilytetään matkojensa kanssa, poistetaan matkan mukana tai kun poistat tietosi, eikä niitä koskaan ladata palvelimelle) sekä pienet asetukset, kuten teemasi ja viimeisin välilehti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Zufallscode, eine Kopie deiner Fahrten und der Karten, die du geöffnet hast, damit Clack ohne Verbindung funktioniert, die Tickets, die du mit Clack teilst (bei ihren Fahrten gespeichert, mit der Fahrt oder beim Löschen deiner Daten entfernt und nie hochgeladen), und kleine Vorlieben wie dein Design und der letzte Tab."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten losowy kod, kopia twoich przejazdów i otwieranych map, aby Clack działał bez połączenia, bilety udostępnione do Clack (przechowywane przy przejazdach, usuwane razem z przejazdem lub gdy usuniesz swoje dane, nigdy nie są wysyłane) oraz drobne preferencje, takie jak motyw i ostatnia karta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce code aléatoire, une copie de vos trajets et des cartes que vous avez ouvertes pour que Clack fonctionne sans connexion, les billets que vous partagez avec Clack (conservés avec leurs trajets, supprimés avec le trajet ou quand vous supprimez vos données, et jamais envoyés), et de petites préférences comme votre thème et le dernier onglet."
          }
        }
      }
    },
    "privacy.phoneTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What stays on your phone"
          }
        },
        "sv" : {
