# Used by `npm run ios` (vite build --mode ios). Not secrets: these end up in the app.
# The server the iOS app talks to (docs/IOS.md, "Put the server online"). Must be https.
VITE_API_BASE=https://REPLACE-WITH-YOUR-SERVER
# Shown on the Privacy page as the contact for data questions (App Review 1.5 and 5.1.1). Leave empty to hide.
VITE_SUPPORT_EMAIL=
# Operators' logos are their trademarks (App Review 5.2.1): off until an operator gives written permission.
VITE_OPERATOR_LOGOS=false
