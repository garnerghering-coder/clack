{
  "name": "@clack/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/supervise.mjs --watch=src --watch=../../packages/shared/src --health=/api/health -- tsx src/index.ts",
    "start": "node ../../scripts/supervise.mjs --health=/api/health -- tsx src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "import": "tsx src/cli.ts",
    "start:once": "tsx src/index.ts"
  },
  "dependencies": {
    "@clack/shared": "*",
    "@fastify/rate-limit": "^11.2.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "hyparquet": "^1.31.5",
    "maplibre-gl": "^5.24.0",
    "node-cron": "^4.6.0",
    "pmtiles": "^4.5.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6"
  }
}
