{
  "name": "clack",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @clack/server",
    "start": "npm run start -w @clack/server",
    "test": "python3 scripts/ios/lint_design.py && vitest run",
    "lint:design": "python3 scripts/ios/lint_design.py",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @clack/server",
    "import": "npm run import -w @clack/server --",
    "stations:validate": "tsx scripts/stations/validate.ts",
    "stations:draft": "python3 scripts/stations/draft_from_osm.py"
  },
  "devDependencies": {
    "lucide-react": "^1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
