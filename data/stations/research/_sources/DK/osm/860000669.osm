  <tag k="note" v="Skiltet rute går via Esumvej i den nordlige del af byen. Ikke via Kongevejen som Naturstyrelsens gpx-track viser. (checked juli 2021 )"/>
  <tag k="route" v="road"/>
  <tag k="symbol" v="Marguerite"/>
  <tag k="type" v="route"/>
 </relation>
