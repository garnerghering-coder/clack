  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Til Minde om faldne Soldater fra Næstved og Omegn i Kampene for Fædrelandet 1848-50 og 1864&#10;&#10;Blod, som Danmarks Jord har drukket,&#10;randt ej uden Frugt,&#10;og det Liv er ej udslukket,&#10;som til Daad blev brugt.&#10;CARL PLOUG&#10;&#10;1848-49-50:&#10;[...]&#10;&#10;D.F.B. 1879"/>
  <tag k="inscription:2" v="1864&#10;[...]&#10;&#10;Rejst af Selskabet &quot;De danske Forsvarsbrødre for Næstved og Omegn&quot; paa dets 25 aarige Stiftelsesdag den 14de April 1904."/>
  <tag k="material" v="dry_stone"/>
  <tag k="memorial" v="war_memorial"/>
  <tag k="name" v="Minde"/>
  <tag k="note" v="The names on the upper stone could probably be scanned in using Google Lens or the like (and then checked for errors), but parts of the lower stone are too worn."/>
  <tag k="start_date" v="1904-04-19"/>
 </node>
