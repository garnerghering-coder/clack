  <tag k="name" v="Garderstatuen"/>
  <tag k="source" v="https://www.garderforeningerne.dk/om-dg/"/>
  <tag k="start_date" v="1958"/>
  <tag k="statue:description" v="Monument over Livgardens faldne. Gave fra De Danske Garderforeninger i anledning af Den Kongelige Livgardes 300 års jubilæum."/>
  <tag k="statue:description:en" v="Monument to the fallen of the Royal Life Guards. Gift from the Danish Guards Associations on the occasion of the Royal Life Guard's 300th anniversary."/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="artwork"/>
 </node>
 <node id="12666500059" visible="true" version="1" changeset="163646214" timestamp="2025-03-15T11:10:46Z" user="Castanea sativa" uid="22161222" lat="55.6852862" lon="12.5768035">
  <tag k="artist_name" v="François Dieussart; Jan Olsen"/>
  <tag k="artwork_type" v="bust"/>
  <tag k="bust:description" v="Nyafstøbning af gipsbuste, som oprindeligt er udført af François Dieussart omkring 1661 og som opbevares på Frederiksborg Slot. Nyafstøbningen er udført af bronzestøber Jan Olsen."/>
  <tag k="bust:description:en" v="New cast of plaster bust which was originally made by François Dieussart around 1661 and is kept at Frederiksborg Castle. The new cast was made by bronze molder Jan Olsen."/>
  <tag k="material" v="bronze"/>
  <tag k="name" v="Kong Frederik III"/>
  <tag k="name:en" v="King Frederick III"/>
  <tag k="pedestal:description" v="Granitpiedestalen er hugget af stenhugger Lars Nielsen."/>
  <tag k="pedestal:description:en" v="The granite pedestal was carved by stonemason Lars Nielsen."/>
  <tag k="pedestal:material" v="granite"/>
  <tag k="source" v="https://www.garderforeningerne.dk/om-dg/"/>
  <tag k="support" v="pedestal"/>
  <tag k="tourism" v="artwork"/>
  <tag k="wikimedia_commons" v="File:Frederik_III_buste.jpg"/>
  <tag k="wikimedia_commons:description" v="Fotografiet viser ikke nyafstøbningen ved Rosenborg Eksercerplads, men François Dieussarts gipsbuste fra omkring 1661."/>
  <tag k="wikimedia_commons:description:en" v="The photograph does not show the new casting at Rosenborg Parade Ground, but the plaster bust made by François Dieussart around 1661."/>
 </node>
