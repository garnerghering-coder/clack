  "_composition_comment": "Checked against the coach order of every SJ departure at Cst, G, M, Sund, Ö and U on 2026-10-21 (ONBOARD_DATA_FINDINGS.md §2). 'cars' counts the numbered cars of one unit; a locomotive ('Lok-') is not counted, and doubled sets ('1-3-4-5-6-7, 8-10-11-12-13-14') count per unit. First match wins; no match falls back to 'rules'.",
  "composition_rules": [
    { "match": { "operator": "sj", "product": "high_speed", "locomotive": false, "cars": 6 }, "type": "x2000" },
    { "match": { "operator": "sj", "product": "high_speed", "locomotive": false, "cars": 4 }, "type": "x55" },
    { "match": { "operator": "sj", "product": "night", "locomotive": true }, "type": "rc6_sleeper" },
    { "match": { "operator": "sj", "locomotive": true }, "type": "rc6_coaches" },
    { "match": { "operator": "sj", "product": "regional", "locomotive": false, "cars_max": 3 }, "type": "x40" }
  ],
